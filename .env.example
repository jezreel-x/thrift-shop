# Copy to .env and fill in. .env is gitignored; never commit real credentials.
#
# Four databases, with strictly separate jobs. The separation is deliberate:
# before it existed, running the development server read and wrote the live
# catalogue, and a local experiment created a real customer in production.

# ---------------------------------------------------------------------------
# The application
# ---------------------------------------------------------------------------

# What `npm run dev` and the deployed site read.
#
# Locally this is the Docker container, so development cannot touch live stock,
# customers or orders. On Vercel it is set to Neon's *pooled* connection string
# in the project settings — serverless functions open many short-lived
# connections and Postgres will not tolerate them directly.
DATABASE_URL="postgresql://thrift:thrift@localhost:5434/thrift_shop_dev"

# ---------------------------------------------------------------------------
# Local databases, both in the container started by `npm run db:test:up`
# ---------------------------------------------------------------------------

# Where `npm run db:migrate` generates and tries new migrations. Seeded rather
# than empty, because an empty database is exactly where a bad migration looks
# fine: adding a NOT NULL column succeeds against no rows and fails against real
# ones.
DEV_DATABASE_URL="postgresql://thrift:thrift@localhost:5434/thrift_shop_dev"

# The integration suite, which truncates every table between tests. The name
# must end in _test — the suite refuses anything else rather than trust a
# connection string not to be production.
TEST_DATABASE_URL="postgresql://thrift:thrift@localhost:5434/thrift_shop_test"

# ---------------------------------------------------------------------------
# Production, reached only on purpose
# ---------------------------------------------------------------------------

# Neon without the pooler. Used by `npm run db:deploy` and `db:status`, and by
# Vercel when it applies migrations during a build. Prisma Migrate holds a
# session-level advisory lock across statements, which PgBouncer's transaction
# pooling does not support.
DIRECT_DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=verify-full"

# Neon's pooled string. Kept for reference and for pointing a script at
# production deliberately; nothing reads it automatically.
PRODUCTION_DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=verify-full"

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Vercel Blob, for product photography. Created in the Vercel dashboard under
# Storage, then connected to this project. Read-write: it can delete images as
# well as create them, so it is a server-side secret and never reaches a browser.
# Used by the admin's photo uploads and by `npm run seed:upload`. On Vercel it is
# set automatically when the store is connected to the project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx_yyyyyyyyyyyyyyyyyyyyyyyy"

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------

# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>` to the daily
# tidy-up (vercel.json). Any long random string: `openssl rand -hex 32`. Unset,
# the job refuses every request, so it never runs for a stranger.
CRON_SECRET="a-long-random-string"
