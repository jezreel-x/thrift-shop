# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# Hosted Postgres (Neon), pooled connection — used by the app at runtime.
# Its host contains "-pooler". Serverless functions open many short-lived
# connections and Postgres will not tolerate them directly.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=verify-full"

# The same database without the pooler — used by Prisma Migrate, which takes
# session-level advisory locks that PgBouncer's transaction mode does not
# support. Identical to the above with "-pooler" removed from the host.
DIRECT_DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=verify-full"

# Local Postgres for integration tests, started by `docker compose up -d`.
# The suite truncates every table, so the name must end in _test — the global
# setup refuses anything else.
TEST_DATABASE_URL="postgresql://thrift:thrift@localhost:5434/thrift_shop_test"
