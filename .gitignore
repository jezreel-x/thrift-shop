# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma client, generated from prisma/schema.prisma by `npm run db:generate`
/src/generated

# vendor agent-skill packs installed by `prisma init` — reference docs, not project code
/.agents/
/.windsurf/
/.claude/skills/
/skills-lock.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Seed photography. The originals are not committed: git has no delta
# compression for binaries, so every reshoot would live in history forever, and
# production serves these from blob storage anyway. `npm run seed:upload`
# uploads them and writes prisma/seed-manifest.json, which IS committed.
/seed-images/*
!/seed-images/README.md
