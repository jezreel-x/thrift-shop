// Thrift Shop — data model.
//
// The governing constraint of this domain is that every item is one of one.
// There is no quantity column anywhere, and there never should be: a product
// row IS the garment. That is what makes `status` load-bearing rather than
// decorative, and it is why two buyers reaching checkout at the same moment is
// a correctness problem instead of an inventory one.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------- Enums -----------------------------

// The shop's actual range, garment by garment.
//
// Deliberately not broad shelves like TOPS and BOTTOMS. "Hoodies" is something
// people search for; "tops" is not, and flattening hoodies, sweatshirts,
// flannels and T-shirts into one bucket would discard exactly the distinction
// buyers browse by.
//
// A closed enum rather than a Category table: the range changes rarely, and
// exhaustive checking in TypeScript means a category cannot be added without
// every filter and label that renders it being updated too. The upgrade path,
// if the owner ever needs to manage her own categories, is a table — but paying
// for that flexibility now buys nothing.
enum Category {
  HOODIES
  SWEATSHIRTS
  T_SHIRTS
  FLANNELS
  SWEATPANTS
  WIDE_LEG_SWEATPANTS
  SIDE_POCKET_PANTS
  UNDERWEAR
}

// Who a garment is cut for.
//
// Not a statement about who may buy it: UNISEX is a common and advertised
// answer in this stock. Recorded because it is the filter buyers reach for
// immediately after size.
enum Gender {
  MENS
  WOMENS
  UNISEX
}

// Condition is the single biggest driver of price and of returns complaints in
// secondhand clothing, so it is a closed set rather than free text. Four grades
// is the most a buyer can meaningfully distinguish from photographs.
enum Condition {
  NEW_WITH_TAGS
  EXCELLENT
  GOOD
  FAIR
}

// AVAILABLE -> RESERVED -> SOLD is the happy path. RESERVED is temporary and
// always carries an expiry (see Product.reservedUntil); a reservation that
// lapses returns to AVAILABLE. SOLD is terminal.
enum ProductStatus {
  AVAILABLE
  RESERVED
  SOLD
}

// ---------------------------- Models -----------------------------

model Product {
  id String @id @default(cuid())

  // The URL segment: /products/vintage-levis-501-straight-w32. Server rendering
  // is the entire reason this project uses Next.js, and a readable slug is a
  // meaningful part of what search engines reward — an opaque cuid in the URL
  // would waste most of that advantage. Generated from the title, with a short
  // suffix when two items collide, because "black leather jacket" will recur.
  slug String @unique

  title       String
  description String?

  // Brand drives search in secondhand clothing more than any field except size:
  // people hunt for Levi's and Nike by name. Nullable because plenty of thrift
  // stock has no legible label left.
  brand String?

  // Integer minor units (KES cents), never a float. See src/lib/money.ts for the
  // reasoning and the parsing rules.
  priceCents Int

  // Free text rather than an enum. The current range is letter-sized throughout,
  // but one column has to be able to hold "M", "W32" and "UK 8" the moment she
  // stocks jeans or shoes — and a database enum would make each of those a
  // migration. The permitted values per category are pinned in TypeScript
  // instead, so writes stay clean without the schema having to know what a size
  // is.
  //
  // Buyers filter by size before anything else, hence the composite index below.
  size String

  // The old fixed list. Still written until the contract migration; the shop
  // reads categoryId.
  category Category

  // The category as data: its name, its options and its size list. Optional
  // only until the contract migration, after the backfill has set every row.
  categoryId  String?
  categoryRef ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Meaningful for thrift and second-hand, not for new stock: shown only where
  // the category switches it on (ProductCategory.showCondition).
  condition Condition?

  // Cut, not audience. The shop advertises men's, women's and unisex stock
  // explicitly, and this is the filter buyers want directly after size.
  // Shown only where the category switches it on (ProductCategory.showFit):
  // clothing yes, perfume no.
  gender Gender?

  status ProductStatus @default(AVAILABLE)

  // When the current reservation lapses. Non-null only while status is RESERVED.
  // A RESERVED row without an expiry is an item lost from the catalogue forever,
  // so the two are written and cleared together.
  reservedUntil DateTime?

  // Who holds the current reservation — a session or user id, kept opaque so the
  // reservation layer does not need to know what authentication looks like.
  //
  // Without it a hold is anonymous, and any second visitor could complete
  // checkout on someone else's reservation: the whole point is that this item is
  // promised to one person for fifteen minutes.
  reservedBy String?

  images        ProductImage[]
  statusHistory ProductStatusHistory[]
  // What is actually bought. One per product for a thrift item; one per
  // colour-and-size combination for stock. See docs/product-variants.md.
  variants      ProductVariant[]
  swatches      ProductSwatch[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete. A mis-deleted item is recoverable, and an item that has been
  // sold must not vanish from the order that sold it. Every catalogue query
  // filters on `deletedAt: null`.
  deletedAt DateTime?

  // The catalogue's own query is "available items, filtered, newest first", so
  // status leads every composite index. Size comes second because it is the
  // filter buyers reach for first.
  @@index([status, size])
  @@index([status, category])
  @@index([status, gender])
  @@index([status, priceCents])
  @@index([status, createdAt])
  @@index([deletedAt])
  // The sweep asks for reservations that have lapsed. Without this it scans the
  // whole catalogue every time it runs, which is every minute or so forever.
  @@index([status, reservedUntil])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Which option-1 value (Khaki, Gold) this photo shows. Null: every one.
  swatchId String?
  swatch   ProductSwatch? @relation(fields: [swatchId], references: [id], onDelete: SetNull)

  // Where the image is served from.
  url String

  // The storage key. Held separately from the URL because deleting a blob needs
  // the key, and parsing it back out of a URL is the kind of thing that works
  // until the provider changes its URL format.
  pathname String @unique

  // Empty alt is a legitimate choice for a purely decorative image, but a
  // product photo is never decorative, so this should always be filled in.
  alt String?

  // Intrinsic dimensions, stored so <Image> can reserve space before the file
  // loads. Without them the page reflows as each photo arrives, which is a Core
  // Web Vitals penalty and looks broken on a phone.
  width  Int
  height Int

  // Display order. Position 0 is the card thumbnail — the single most important
  // image, and a choice the owner makes rather than upload order deciding.
  position Int @default(0)

  // SHA-256 of the file, computed in the browser before upload and used as the
  // storage path. Re-uploading the same photo therefore overwrites rather than
  // duplicates, which makes a double-submitted form idempotent instead of
  // expensive.
  checksum String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, position])
  @@index([checksum])
}

// An append-only record of every status transition.
//
// `status` on Product is overwritten in place, so without this the answer to
// "when did this sell, and what moved it?" is unrecoverable. That question gets
// asked during payment disputes, which is exactly when reconstructing it from
// memory is least convincing.
model ProductStatusHistory {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Null on the first row, which records the item entering the catalogue.
  fromStatus ProductStatus?
  toStatus   ProductStatus

  // Free text: "payment confirmed", "reservation expired", "returned by buyer".
  reason String?

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

// ----------------------------- Accounts -----------------------------

model User {
  id String @id @default(cuid())

  // Stored lowercased, and compared that way. Nobody thinks of Grace@… and
  // grace@… as two accounts, and letting both exist means one of them silently
  // cannot log in.
  email String @unique

  // argon2id. Never the password, never a reversible encoding of it.
  passwordHash String

  // What to call them in an order confirmation. Optional because insisting on it
  // at sign-up costs completions, and the shop can ask at checkout instead.
  name String?

  // Canonical 254XXXXXXXXX. Asked for once at checkout and remembered, because
  // a shop that confirms payments by hand and arranges delivery over WhatsApp
  // needs a way to reach the buyer, and retyping it every order is how a
  // purchase gets abandoned.
  phone String?

  // Everyone is a customer. Being staff means holding at least one StaffRole;
  // there is no flag to set, so there is no flag to forget to unset.
  staffRoles StaffRoleAssignment[]

  sessions  Session[]
  cart      Cart?
  orders    Order[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A signed-in browser.
//
// Sessions live in the database rather than in a signed token, which makes
// revocation a DELETE instead of a problem. A JWT cannot be withdrawn once
// issued, which is why systems that use them grow refresh tokens, rotation,
// reuse detection and a revocation list — machinery that exists entirely to
// claw back control that was given away by the choice of mechanism. One indexed
// lookup per request is a cheaper price, on a page that already queries this
// database to render itself.
model Session {
  // The SHA-256 of the token in the cookie, never the token itself — so a
  // database leak yields nothing anyone can sign in with.
  //
  // Hashed with SHA-256 rather than argon2 deliberately: argon2 is slow on
  // purpose to make guessing a human-chosen password expensive. This token is
  // 32 random bytes, so guessing is already hopeless, and slow hashing here
  // would only tax every page load.
  id String @id

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Sliding: extended when the session is used, so somebody who keeps shopping
  // is never signed out, and somebody who stops is forgotten a week later.
  expiresAt DateTime

  // For the account page: "Chrome on Android, last used yesterday". Enough to
  // recognise a session that is not yours, and nothing more identifying than the
  // request already carried.
  userAgent String?
  ipAddress String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  // The sweep that clears expired sessions asks only this.
  @@index([expiresAt])
}

// ------------------------------- Cart -------------------------------

// A shortlist, not a claim on anything.
//
// Adding to a cart reserves nothing. If it did, anyone could freeze the whole
// catalogue by browsing: ten shoppers with five items each would empty a
// one-of-one shop while selling nothing. Two carts may hold the same jacket;
// whoever reaches checkout first gets it.
//
// What it is actually for, in a shop where payment is confirmed by hand: three
// items become one M-Pesa transaction, one confirmation code and one approval,
// instead of three of each.
model Cart {
  id String @id @default(cuid())

  // Null while the shopper is anonymous — the cart is found by a cookie until
  // they sign in, at which point it is claimed or merged into the one they
  // already had. Unique because a person has one cart.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  // Touched whenever the contents change, so abandoned anonymous carts can be
  // swept without disturbing one somebody is still using.
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // Kept alongside the variant: removing a product still empties it from carts.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // What the shopper picked. Optional only until the contract migration.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // 1 to 5. The cart reserves nothing, so this is a wish, checked against what
  // is free every time the cart is shown and again at checkout.
  quantity Int @default(1)

  createdAt DateTime @default(now())

  // One line per variant: adding the same size again raises the quantity.
  @@unique([cartId, variantId])
  @@index([cartId])
}

// ------------------------------ Orders ------------------------------

// Where an order is in the one flow it has.
//
// Payment is confirmed by a person reading their M-Pesa messages, so the
// interesting states are the two waits: the buyer paying, and the owner
// checking. Everything else is terminal.
enum OrderStatus {
  // Items are held; the buyer has not said they have paid.
  AWAITING_PAYMENT
  // The buyer has given an M-Pesa code. Nobody has checked it yet.
  PENDING_CONFIRMATION
  // The owner matched it against her SMS. Items are SOLD.
  CONFIRMED
  // The owner could not match it. Items returned to the rail.
  REJECTED
  // Abandoned, or every hold lapsed before payment.
  CANCELLED
}

model Order {
  id String @id @default(cuid())

  // What the buyer quotes and the owner searches for. Short, and drawn from an
  // alphabet without 0/O or 1/I/L, because it gets read aloud over WhatsApp and
  // typed back by someone who is not looking at the screen.
  reference String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status OrderStatus @default(AWAITING_PAYMENT)

  // Copied at checkout rather than read from the account later. An order is a
  // record of an agreement, and the phone number it was placed with is part of
  // that — changing it on the profile afterwards must not rewrite history.
  buyerName  String
  buyerPhone String

  // The M-Pesa transaction code the buyer says they paid with.
  //
  // Unique across every order, and that constraint is the single most effective
  // check available in v1: the app cannot ask Safaricom whether a code is real,
  // but it can refuse to let one be spent twice. Reusing a code from an earlier
  // purchase — or one a friend forwarded — fails at the database.
  mpesaCode String?   @unique
  claimedAt DateTime?

  // The owner's decision, and why.
  reviewedAt DateTime?
  reviewNote String?

  // What the buyer actually agreed to pay, summed at checkout. Never recomputed
  // from current prices.
  totalCents Int

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  // Restrict, not Cascade: a product that has been sold cannot be deleted out
  // from under the order that sold it. Withdrawing it from the catalogue is what
  // `deletedAt` is for.
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Snapshots of what was sold, at the price agreed.
  //
  // Reading these through the product would mean repricing an item silently
  // rewrites the history of every order that contained it — a bug you discover
  // during a dispute, which is the worst possible moment.
  title      String
  size       String
  priceCents Int

  // What exactly was bought. Optional only until the contract migration,
  // after the backfill has pointed every existing row at its variant.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // Snapshot of the option-1 value ("Khaki"), alongside title, size and price.
  swatch String?

  // How many units at priceCents each.
  quantity Int @default(1)

  // A variant appears at most once on an order; two sizes of one product are
  // two lines.
  @@unique([orderId, variantId])
  @@index([productId])
  @@index([variantId])
}

// ----------------------------- Settings -----------------------------

// How the shop takes money, and anything else the owner sets rather than a
// developer.
//
// In the database rather than in environment variables because of who owns it.
// A connection string belongs to whoever deploys; a till number belongs to the
// shop. If she moves from Pochi to a registered paybill, that is a Tuesday — it
// should not need a developer and a release.
//
// One row. Typed columns rather than the key/value pairs a larger platform would
// use: with a handful of settings, columns give validation and no parsing at
// every read, and a key/value store only pays off once adding a setting would
// otherwise mean a migration every week.
//
// Phase 3 puts an admin form on this, and that is when an audit of changes earns
// its place — a till number that changed without anyone remembering is how money
// reaches the wrong account, and it is unanswerable afterwards without a record.
model ShopSettings {
  // Fixed, so there can only ever be one row.
  id String @id @default("singleton")

  // Null until the owner has somewhere to be paid. Checkout says so plainly
  // rather than inventing a number.
  payment       PaymentMethod?
  paymentName   String? // "The Thrift Plug" — what the buyer sees on their phone
  // Till, paybill or phone number, depending on `payment`.
  tillNumber    String?
  // Paybill only: what the buyer puts in the account field.
  accountNumber String?

  // Shown on the checkout page, under the payment details.
  paymentNote String?

  // The shop's WhatsApp, canonical 2547XXXXXXXX. Where "Order on WhatsApp"
  // opens a chat with the order already written. Null: the button is hidden.
  whatsappNumber String?

  updatedAt DateTime @updatedAt
}

enum PaymentMethod {
  // Buy Goods and Services — a till number.
  TILL
  // Paybill, which also needs an account number.
  PAYBILL
  // Send Money to a phone number: Pochi la Biashara or a personal line. The
  // buyer's steps and the name check are the same either way; only where the
  // money lands differs, so one value covers both. Named POCHI for history.
  POCHI
}

// ------------------------- Staff and access -------------------------

// What a member of staff may do.
//
// Defined in code, because only code can enforce a permission: adding one to a
// table without a check that reads it would grant nothing. Roles, by contrast,
// are rows, so the owner can reshape who does what without a deploy.
//
// Named for operations, not screens. JaGedo attaches its permissions to admin
// menu items, which couples the security model to the navigation — rename or
// split a menu and the permissions move with it. An operation is what the code
// actually checks before it changes something.
enum Permission {
  // Orders
  ORDERS_VIEW
  ORDERS_CONFIRM_PAYMENT
  ORDERS_FULFIL
  // Products
  PRODUCTS_VIEW
  PRODUCTS_EDIT
  PRODUCTS_MARK_SOLD
  PRODUCTS_HOLD
  // People
  CUSTOMERS_VIEW
  STAFF_MANAGE
  // The shop
  SETTINGS_EDIT
  AUDIT_VIEW
}

model StaffRole {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  // Holds every permission, including ones added after the role was created.
  // Without this, adding a permission to the enum would lock the owner out of
  // the new feature until somebody remembered to grant it to her.
  isSuperAdmin Boolean @default(false)

  permissions StaffRolePermission[]
  assignments StaffRoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffRolePermission {
  roleId     String
  role       StaffRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission

  @@id([roleId, permission])
}

// Who holds which role.
//
// Revoking deletes the row rather than flipping an isActive flag as JaGedo
// does. The audit log already records that the role was held and when it was
// taken away, and a flag is one more condition every access check must
// remember to apply.
model StaffRoleAssignment {
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   StaffRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

// ---------------------------- Audit log -----------------------------

// Every change made from the admin area, with what it was before and after.
//
// The questions this answers arrive after something has gone wrong: who
// changed the till number, who confirmed that payment, who gave this person
// access. They are unanswerable from the current state of the database alone.
//
// Append-only by convention: nothing in the application updates or deletes a
// row here.
model AuditLog {
  id String @id @default(cuid())

  // Null when the change came from a script rather than a person signed in —
  // bootstrapping the first owner, for instance.
  actorId String?
  // SetNull, so deleting a user keeps the record of what they did.
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // "order.confirm-payment", "staff.grant-role", "settings.update-payment".
  action     String
  entityType String
  entityId   String

  before Json?
  after  Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ------------------------------ Variants and stock ------------------------------
//
// See docs/product-variants.md. A product has up to two options: option 1, the
// look (Colour, Metal), held here as swatches with their own photos; option 2,
// the fit or amount (Size, Waist, Volume), held as text on each variant.

model ProductSwatch {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // As the owner writes it: "Khaki", "Rose gold".
  name     String
  // The dot on the swatch, "#c3b091". Optional: a metal may be better as a word.
  hex      String?
  position Int     @default(0)

  variants ProductVariant[]
  images   ProductImage[]

  createdAt DateTime @default(now())

  @@unique([productId, name])
  @@index([productId, position])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Null: the product has no option 1.
  swatchId String?
  swatch   ProductSwatch? @relation(fields: [swatchId], references: [id], onDelete: Restrict)

  // "M", "32", "100 ml". Null: the product has no option 2.
  option2 String?

  // Units in the shop and not yet sold. It moves only when a sale is confirmed
  // or the owner changes it, and every move is in StockMovement. Holds do not
  // touch it: what a buyer can take is stock minus unexpired holds, worked out
  // when they reserve. Never negative, by a CHECK in the migration.
  stock Int @default(0)

  // Null: use the price on the product.
  priceCents Int?

  holds      StockHold[]
  movements  StockMovement[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per combination. The migration makes this NULLS NOT DISTINCT, so a
  // product with no options still gets exactly one variant. Prisma cannot
  // express that, so the SQL is edited by hand.
  @@unique([productId, swatchId, option2])
  @@index([productId])
}

// A buyer holding units while they check out and pay.
//
// Expiry is a matter of time, not of a job running: a hold past expiresAt
// simply stops counting. Deleting expired rows is tidiness, nothing more.
model StockHold {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // A user id, kept opaque as Product.reservedBy was.
  holder    String
  quantity  Int
  // 15 minutes at checkout; 24 hours once payment is claimed.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One hold per buyer per variant: checking out again extends it.
  @@unique([variantId, holder])
  @@index([variantId, expiresAt])
  @@index([expiresAt])
}

// The ledger: every change to ProductVariant.stock, with why and who.
model StockMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // -1 sold, +5 restock, -1 sold elsewhere.
  change Int
  // "opening stock", "sale confirmed", "sold elsewhere", "restock", "count corrected".
  reason String

  orderId String?
  // Who, when a person did it. Not a relation: the ledger outlives accounts.
  actorId String?

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
}

// ------------------------------ Categories ------------------------------
//
// Data the owner manages, not a list in the schema: a new kind of stock
// (Sneakers, Rings, Fragrance) is a row, not a migration. Each category is the
// template for its products: the names of their two options and the values
// option 2 is offered in. See docs/product-variants.md.
model ProductCategory {
  id       String @id @default(cuid())
  // In URLs and filters: /?category=wide-leg-sweatpants.
  slug     String @unique
  name     String
  // Order in the filters and menus.
  position Int    @default(0)

  // "Colour" | "Metal" — null when products here have no option 1.
  option1Name   String?
  // "Size" | "Waist" | "Ring size" | "Volume" — null when they have no option 2.
  option2Name   String?
  // Offered in this order: ["XS","S","M","L","XL","XXL"], ["28","30",…].
  option2Values String[]

  // Whether Condition (Excellent, Good…) and Fit (Men's, Women's, Unisex)
  // apply to products here.
  showCondition Boolean @default(true)
  showFit       Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}
